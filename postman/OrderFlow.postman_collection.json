      "name": "5. Chaos controls (payment-service, port 8081)",
      "item": [
        {
          "name": "Show chaos settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{paymentUrl}}/api/chaos",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "api",
                "chaos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway DOWN (100% failures)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentUrl}}/api/chaos",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "api",
                "chaos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failureRate\": 1.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Place an order now: Temporal retries, the circuit breaker opens, and the order ends CANCELLED with stock restored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway SLOW (every call takes 3 s, client timeout is 2 s)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentUrl}}/api/chaos",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "api",
                "chaos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failureRate\": 0.0,\n  \"slowRate\": 1.0,\n  \"slowDelayMs\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Calls time out and are retried with the same Idempotency-Key, so the customer is never charged twice."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset gateway (healthy)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentUrl}}/api/chaos",
              "host": [
                "{{paymentUrl}}"
              ],
              "path": [
                "api",
                "chaos"
              ]
            },
            "body": {
              "mode": "raw",
